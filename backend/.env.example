DATABASE_URL=postgresql+psycopg://crmoney:crmoney@localhost:5432/crmoney
ENVIRONMENT=development
# Em desenvolvimento, use admin@crmoney.com / Admin@123 para o acesso administrativo fixo.
APP_VERSION=0.2.0
JWT_SECRET_KEY=development-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_IDLE_TIMEOUT_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

EMAIL_PROVIDER=console

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=CRMoney

SMTP_USE_TLS=true
SMTP_USE_SSL=false

FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
REDIS_URL=redis://localhost:6379/0
STORAGE_BACKEND=local
STORAGE_PATH=uploads
LOG_LEVEL=INFO
ENABLE_DOCS=true
